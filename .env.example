# 知乎数据开放平台（必填：从 https://developer.zhihu.com/profile 复制 Access Secret）
ZHIHU_ACCESS_SECRET=

# 随机抽题时静默过滤的答主昵称（逗号分隔，仅过滤随机推荐，不拦截主动搜索）
ZHIHU_RANDOM_BLOCKED_AUTHORS=

# 大模型 OpenAI 兼容接口（可选；留空时默认走知乎直答或内置回放模式）
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 神经反演推理服务（可选；P1 阶段接入 TensorTract3 云端极薄 API）
TENSORTRACT_API_URL=
